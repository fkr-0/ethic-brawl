{
  "name": "ethic-brawl",
  "version": "1.7.4",
  "description": "A 2.5D cyberpunk philosophical arena-brawler with absurd humor",
  "type": "module",
  "main": "desktop/main.mjs",
  "desktopName": "dev.arcade.ethic-brawl",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:dir": "pnpm build && electron-builder --dir --linux",
    "desktop:appimage": "pnpm build && electron-builder --linux AppImage --publish never",
    "build": "tsc && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "imports:fix": "biome check --write --assist-enabled=true --only=assist/source/organizeImports src tests e2e",
    "format": "biome format --write .",
    "test:single": "vitest run",
    "test:simulation": "vitest run tests/unit/*runtime*.test.ts tests/unit/*system*.test.ts tests/unit/gameplay-architecture.test.ts",
    "release:check": "node scripts/release-check.mjs && pnpm release:plan:check",
    "test:e2e:sprites": "playwright test e2e/sprite-animation.spec.ts",
    "test:e2e:sprite-review": "playwright test e2e/sprite-visual-review.spec.ts",
    "test:e2e:sprite-review:update": "ETHIC_SPRITE_REVIEW_DIR=generated/sprite-visual-review playwright test e2e/sprite-visual-review.spec.ts",
    "assets:audit": "python3 scripts/audit-sprite-assets.py",
    "assets:fullset-v2": "python3 scripts/curate-animation-v2-fullset.py --sync-runtime",
    "assets:fullset-v2:check": "python3 scripts/curate-animation-v2-fullset.py --check",
    "assets:build": "python3 scripts/build-character-animation-v2.py --character all && python scripts/build-release-atlases.py && python scripts/build-character-extensions.py",
    "assets:animation-v2": "python3 scripts/build-character-animation-v2.py --character all",
    "assets:animation-v2:check": "python3 scripts/build-character-animation-v2.py --character all --check",
    "assets:bakunin-v2": "python3 scripts/build-character-animation-v2.py --character bakunin",
    "assets:bakunin-v2:check": "python3 scripts/build-character-animation-v2.py --character bakunin --check",
    "assets:hegel-v2": "python3 scripts/build-character-animation-v2.py --character hegel",
    "assets:hegel-v2:check": "python3 scripts/build-character-animation-v2.py --character hegel --check",
    "assets:aquinas-v2": "python3 scripts/build-character-animation-v2.py --character aquinas",
    "assets:aquinas-v2:check": "python3 scripts/build-character-animation-v2.py --character aquinas --check",
    "assets:aristotle-v2": "python3 scripts/build-character-animation-v2.py --character aristotle",
    "assets:aristotle-v2:check": "python3 scripts/build-character-animation-v2.py --character aristotle --check",
    "assets:camus-v2": "python3 scripts/build-character-animation-v2.py --character camus",
    "assets:camus-v2:check": "python3 scripts/build-character-animation-v2.py --character camus --check",
    "assets:foucault-v2": "python3 scripts/build-character-animation-v2.py --character foucault",
    "assets:foucault-v2:check": "python3 scripts/build-character-animation-v2.py --character foucault --check",
    "assets:stirner-v2": "python3 scripts/build-character-animation-v2.py --character stirner",
    "assets:stirner-v2:check": "python3 scripts/build-character-animation-v2.py --character stirner --check",
    "assets:kant-v2": "python3 scripts/build-character-animation-v2.py --character kant",
    "assets:kant-v2:check": "python3 scripts/build-character-animation-v2.py --character kant --check",
    "assets:marx-v2": "python3 scripts/build-character-animation-v2.py --character marx",
    "assets:marx-v2:check": "python3 scripts/build-character-animation-v2.py --character marx --check",
    "assets:machiavelli-v2": "python3 scripts/build-character-animation-v2.py --character machiavelli",
    "assets:machiavelli-v2:check": "python3 scripts/build-character-animation-v2.py --character machiavelli --check",
    "assets:socrates-v2": "python3 scripts/build-character-animation-v2.py --character socrates",
    "assets:socrates-v2:check": "python3 scripts/build-character-animation-v2.py --character socrates --check",
    "assets:nietzsche-v2": "python3 scripts/build-character-animation-v2.py --character nietzsche",
    "assets:nietzsche-v2:check": "python3 scripts/build-character-animation-v2.py --character nietzsche --check",
    "assets:check": "node scripts/check-release-assets.mjs",
    "prompts:v2:generate": "python3 docs/prompts/fighter-animation-v2/render-prompts.py",
    "prompts:v2:check": "python3 docs/prompts/fighter-animation-v2/render-prompts.py --check",
    "prompts:items:generate": "python3 docs/prompts/item-sprites/render-prompts.py",
    "prompts:items:check": "python3 docs/prompts/item-sprites/render-prompts.py --check",
    "release:plan:check": "node scripts/verify-release-train.mjs"
  },
  "build": {
    "appId": "dev.arcade.ethic-brawl",
    "productName": "Ethic Brawl",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.mjs",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "syncDesktopName": true
    }
  },
  "keywords": [
    "game",
    "brawler",
    "cyberpunk",
    "philosophy",
    "canvas"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "1.60.0",
    "@types/node": "^24.13.3",
    "@vitest/ui": "^2.1.9",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
